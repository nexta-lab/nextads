<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_nds_contract" model="ir.ui.view">
        <field name="name">product.template.form.nds.contract</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']//group[@name='extra_info']" position="inside">
                <field name="nds_contract_type"/>
            </xpath>
        </field>
    </record>
</odoo>
