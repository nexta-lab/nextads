<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formato propio: márgenes laterales por CSS para que la banda del pie vaya a sangre -->
    <record id="paperformat_nds_quote" model="report.paperformat">
        <field name="name">NextaDS - Presupuesto A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">31</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">23</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_nds_quote"/>
    </record>
    <record id="sale_pdf_quote_builder.action_report_saleorder_raw" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_nds_quote"/>
    </record>
    <record id="sale.action_report_pro_forma_invoice" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_nds_quote"/>
    </record>
</odoo>
