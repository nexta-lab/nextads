<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aviso en el enlace del pedido mientras falte firmar la documentación -->
    <template id="sale_order_portal_template_nds_sign" inherit_id="sale.sale_order_portal_template"
              name="NextaDS: documentación pendiente de firma" priority="60">
        <xpath expr="//div[@id='modalaccept']" position="before">
            <t t-set="nds_sign_pending" t-value="sale_order._nds_customer_has_to_sign()"/>
            <div t-if="nds_sign_pending" class="nds-portal nds-p-signbox d-print-none" id="nds_sign_pending">
                <div class="nds-p-signbox-text">
                    <div class="nds-p-eyebrow">Último paso</div>
                    <strong>Falta firmar la documentación del pedido</strong>
                    <p>Contrato y, si hay cuotas, la orden de domiciliación SEPA. Se firma en línea, en un par de minutos.</p>
                </div>
                <a class="btn btn-primary nds-p-signbox-btn" t-att-href="sale_order._nds_customer_sign_url()">
                    <i class="fa fa-pencil me-1"/> Revisar y firmar
                </a>
            </div>
        </xpath>
    </template>
</odoo>
